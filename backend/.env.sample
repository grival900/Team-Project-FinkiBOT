# Database
DATABASE_URL=postgresql+psycopg://finkibot:finkibot@localhost:5432/finkibot

# LLM (chat assistant + quiz generation) — Gemini API free tier (no card needed):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Second provider, used as an automatic fallback when the preferred one (default:
# Gemini) hits a quota/rate-limit error, and switchable as the preferred one from
# the admin panel. Free API key (no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=gemini

# Embeddings (local, no API key needed)
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Chat retrieval relevance floor: a retrieved chunk whose cosine similarity to the
# question is below this is dropped before it reaches the model's context or the cited
# source list — this is what stops the assistant citing a page that only mentions a
# name in passing. On this corpus with bge-m3, a real on-topic chunk scores ~0.45-0.8
# and incidental overlap ~0.33-0.40. Also settable live via a `chat_min_score`
# site_settings row.
CHAT_MIN_SCORE=0.40

# Email notifier
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FinkiBOT <noreply@finkibot.local>
SMTP_USE_TLS=false

# Used to build confirmation links sent in subscription emails
APP_BASE_URL=http://localhost:8000

# Scraping
SCRAPE_USER_AGENT=FinkiBOT/0.1 (+https://github.com/finki-bot; contact: grival900@yahoo.com)
SCRAPE_REQUEST_DELAY_SECONDS=1.0
# Caps how many official course syllabus pages get fetched per run (one HTTP request
# each, no bulk endpoint — this is the single most expensive scraper). Course identity
# itself (name/level/semester/professors/prerequisites) already comes from finki-hub's
# courses.json; this only adds syllabus prose (objectives/content outline/literature)
# on top, so a partial pass is a reasonable default. Leave unset for full coverage.
SCRAPE_SUBJECTS_LIMIT=30

# CORS
FRONTEND_ORIGIN=http://localhost:8080

# Periodic scrape -> index -> notify job. Off by default in dev so `uvicorn --reload`
# doesn't kick off a scrape on every reload. Two cadences (see scrapers/registry.py):
# frequent (announcements + JSON feeds, cheap) runs every SCHEDULER_INTERVAL_MINUTES;
# slow (official course syllabi, professor profiles, recordings — one HTTP request per
# item, 100+ requests a pass) runs far less often, every SCHEDULER_SLOW_INTERVAL_MINUTES.
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_SLOW_INTERVAL_MINUTES=10080

# Signs auth tokens (login sessions) — required, no default. Generate a real one with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Changing this invalidates every existing login session.
JWT_SECRET_KEY=
JWT_EXPIRES_MINUTES=1440
